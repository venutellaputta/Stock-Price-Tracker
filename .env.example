# StockPulse Environment Configuration

# Server Port
PORT=5000

# Authentication Secret
JWT_SECRET=stockpulse_jwt_secret_key_change_in_production_2025

# Database Engine: 'sqlite' or 'postgres'
DB_TYPE=sqlite
DATABASE_URL=file:./stockpulse.db

# Demo Mode (Set to true to run out-of-the-box without financial API keys)
DEMO_MODE=true

# External Financial Stock API Keys (Optional - only required if DEMO_MODE=false)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
